// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Minimal User model to satisfy relations (to be expanded by SG/Ninaad)
model User {
  id          String       @id @default(uuid())
  email       String       @unique
  name        String?
  role        Role         @default(EMPLOYEE)
  attendances Attendance[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum Role {
  EMPLOYEE
  ADMIN
  HR
}

// Attendance Model (Karan's Domain)
model Attendance {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  date          DateTime  @db.Date // Store just the date part for easy querying
  checkInTime   DateTime
  checkOutTime  DateTime?
  
  status        AttendanceStatus @default(PRESENT)
  workHours     Float?    // Calculated on check-out

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, date]) // Ensure only one attendance record per user per day
  @@index([userId, date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
}
